{
  "name": "foval-learning-institute",
  "version": "0.1.0",
  "private": true,
  "description": "Foval Learning Institute: a free, open, general-education university. Content as Markdown, built to a static site.",
  "type": "module",
  "scripts": {
    "build": "node scripts/core-path.mjs && node scripts/build.mjs",
    "validate": "node scripts/core-path.mjs && node scripts/build.mjs --check",
    "path": "node scripts/core-path.mjs",
    "serve": "npx --yes serve site -l 4173",
    "feedback": "node scripts/feedback.mjs",
    "feedback:deploy": "wrangler deploy --cwd workers/feedback",
    "net": "node scripts/net-quotes.mjs",
    "build:drafts": "node scripts/build.mjs --drafts",
    "shots": "node scripts/screenshots.mjs"
  },
  "license": "CC-BY-SA-4.0",
  "dependencies": {
    "js-yaml": "^4.3.2",
    "marked": "^13.0.3"
  },
  "devDependencies": {
    "playwright-core": "^1.56.0"
  }
}
