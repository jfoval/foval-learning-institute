{
  "name": "foval-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foval-feedback",
      "database_id": "87d5eec1-8a69-4620-9c7d-d2e154b55e89"
    }
  ],
  // The accounts that may open #/admin. An account with one of these usernames is John.
  "vars": { "ADMIN_USERNAMES": "johnfoval" },
  // Sign-up, sign-in and reset: 20 a minute from one IP address, which is never stored.
  // Friend requests and cheers: 30 a minute from one account.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SOCIAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
